# Nothing here is required. Start tasklane with only POSTGRES_PASSWORD set (see compose.prod.yaml) and
# connect GitHub and the agent in the console. Use this file only for advanced or automated setups.

# Address people use to reach the console. Set it behind a proxy, and to https://... to get webhooks.
# TASKLANE_PUBLIC_URL=https://tasklane.example.com

# Fix the admin token instead of generating one on first start (at least 24 random characters).
# TASKLANE_ADMIN_TOKEN=

# Settings given here win over what is saved in the console:
# GITHUB_APP_ID=  GITHUB_APP_PRIVATE_KEY_FILE=  GITHUB_INSTALLATION_ID=  GITHUB_WEBHOOK_SECRET=
# ANTHROPIC_API_KEY=
# TASKLANE_SANDBOX=docker  TASKLANE_SANDBOX_IMAGE=tasklane-sandbox  TASKLANE_SANDBOX_NETWORK=bridge
# TASKLANE_ALLOW_UNSANDBOXED=1   # only on a machine that holds nothing else

# Apps that embed the report button: name:secret,name:secret (secrets >= 16 characters)
# TASKLANE_JWT_SECRETS=shop:replace-with-a-long-random-secret

# Tuning
# TASKLANE_WORKERS=2
# TASKLANE_MAX_DEV=1
# TASKLANE_USER_DAILY_LIMIT=10
# TASKLANE_SYNC_SECS=60
# TASKLANE_RETENTION_DAYS=365
