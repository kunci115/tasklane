# --- required ---
POSTGRES_PASSWORD=change-me
# at least 24 characters; used to sign in to the console
TASKLANE_ADMIN_TOKEN=change-me-to-a-long-random-string
# public URL of the console; https:// turns on Secure cookies
TASKLANE_PUBLIC_URL=https://tasklane.example.com

# --- ticket source: GitHub App (see docs/operations.md) ---
GITHUB_APP_ID=
GITHUB_INSTALLATION_ID=
GITHUB_WEBHOOK_SECRET=
# GITHUB_ORG=your-org            # optional: only this account's repositories

# --- agent engine: Claude ---
ANTHROPIC_API_KEY=
# The engine REFUSES to run unless it is sandboxed (TASKLANE_SANDBOX=docker, see
# plugins/engine-claude/README.md) or you accept the risk explicitly. Without the sandbox the
# model's tools run as the same user as the daemon and can read its secrets. Only set this on a
# host that holds nothing else, with repositories and reporters you fully trust:
# TASKLANE_ALLOW_UNSANDBOXED=1

# --- apps that embed the report button: name:secret,name:secret (secrets >= 16 chars) ---
# TASKLANE_JWT_SECRETS=shop:replace-with-a-long-random-secret

# --- optional tuning ---
# TASKLANE_WORKERS=2
# TASKLANE_MAX_DEV=1
# TASKLANE_USER_DAILY_LIMIT=10
# TASKLANE_SYNC_SECS=60
# TASKLANE_RETENTION_DAYS=365   # audit rows older than this are deleted
