 "cards": [
  {
   "dot": "cyan",
   "title": "Input",
   "items": [
    "Install: one docker compose up, then a setup wizard in the console asks for the ticket source login and the engine key; everything else is detected",
    "Tickets from apps via the gateway or from the ticket source; approvals from people"
   ]
  },
  {
   "dot": "amber",
   "title": "Output",
   "items": [
    "PRs, merges to dev/staging, status messages, device actions, audit log"
   ]
  },
  {
   "dot": "violet",
   "title": "State it owns",
   "items": [
    "Postgres holds queue, registry, audit and (built-in) memory; git mirrors and worktrees on disk. a shared memory service can replace the memory plug-in"
   ]
  },
  {
   "dot": "rose",
   "title": "If it fails",
   "items": [
    "One host is a single point of failure; accepted and written down",
    "Stage 1: GitHub + Claude only. Engine adapter, ticket source, notifier and device adapters are fixed interfaces so other engines come next"
   ]
  }
 ],
